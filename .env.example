# Lisht Mail Cleaner - exemple de configuration locale.
# Copier ce fichier en ".env" et ajuster si besoin.
# Le fichier ".env" n'est JAMAIS commite dans Git.

# Fuseau horaire (laisser vide = fuseau du systeme)
LMC_TIMEZONE=

# Seuil d'anciennete en nombre de mois calendaires (defaut : 2)
LMC_AGE_MONTHS=2

# Mode simulation par defaut (true = aucune modification reelle). RECOMMANDE : true
LMC_DRY_RUN=true

# Nombre maximum de messages supprimes definitivement par operation
LMC_MAX_DELETE_PER_RUN=50

# Modele Ollama local
LMC_OLLAMA_MODEL=qwen2.5:1.5b-instruct
LMC_OLLAMA_HOST=http://localhost:11434

# Niveau de journalisation (DEBUG, INFO, WARNING, ERROR)
LMC_LOG_LEVEL=INFO

# Niveau d'acces Gmail demande :
#   lecture   = analyser uniquement (aucune modification)
#   corbeille = analyser + mettre a la corbeille (reversible)
#   complet   = analyser + corbeille + suppression definitive (irreversible)
LMC_ACCESS_LEVEL=corbeille

# Scan hebdomadaire planifie (lecture seule, jamais de suppression automatique).
# Modifiable aussi dans l'interface : Parametres -> Planification.
LMC_SCHEDULE_ENABLED=false
LMC_SCHEDULE_WEEKDAY=6
LMC_SCHEDULE_HOUR=9
LMC_SCHEDULE_MINUTE=0

# Chemins (relatifs au projet par defaut)
LMC_DB_PATH=data/lisht_mail_cleaner.db
LMC_CREDENTIALS_PATH=credentials/credentials.json
LMC_LOG_DIR=logs

# Ne PAS placer de mot de passe Gmail ni de secret ici.
# Les jetons OAuth sont stockes dans le trousseau du bureau, pas dans ce fichier.
